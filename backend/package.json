{
  "name": "monetaire-backend",
  "version": "1.0.0",
  "description": "Monetaire expense tracking backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "migrate:latest": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status"
  },
  "keywords": [
    "finance",
    "expense-tracking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "better-sqlite3": "9.2.2",
    "cors": "2.8.5",
    "csv-parse": "5.5.3",
    "express": "4.18.2",
    "kysely": "0.27.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.3",
    "tsx": "4.7.0",
    "typescript": "5.3.3",
    "vitest": "1.0.4"
  }
}
